      "desc": "一次情報の取得と恒久保存（スナップショット、ハッシュ、取得時刻、point-in-time）",
      "competitor_coverage": "部分（URL のみ）",
      "ip_priority": "must"
    },
    {
      "id": "L1",
      "name": "接地層",
      "desc": "主張 ↔ 原文スパンの機械検証（Fact Check ループ）",
      "competitor_coverage": "弱い（fact-check 39-77%）",
      "ip_priority": "must"
    },
    {
      "id": "L2",
      "name": "整合層",
      "desc": "数値再計算・時系列整合・文書間矛盾検出",
      "competitor_coverage": "不明",
      "ip_priority": "must"
    },
    {
      "id": "L3",
      "name": "反証層",
      "desc": "ACH 行列・反証タスク・レッドチーム・診断的証拠の優先探索",
      "competitor_coverage": "なし",
      "ip_priority": "differentiator"
    },
    {
      "id": "L4",
      "name": "較正層",
      "desc": "主張ごとの確率と較正履歴（Brier/ECE）",
      "competitor_coverage": "なし",
      "ip_priority": "differentiator"
    },
    {
      "id": "L5",
      "name": "記憶層",
      "desc": "案件横断のケースベース記憶（外した理由を含む）",
      "competitor_coverage": "なし",
      "ip_priority": "moat"
    },
    {
      "id": "L6",
      "name": "協働層",
      "desc": "人間の介入点（仮説承認/反証優先度/一次情報投入/確度上書き）",
      "competitor_coverage": "弱い",
      "ip_priority": "should"
    },
    {
      "id": "L7",
      "name": "監査層",
      "desc": "探索木の追記専用保存・改竄検知・再現",
      "competitor_coverage": "不明",
      "ip_priority": "must"
    },
    {
      "id": "L8",
      "name": "自己改善層",
      "desc": "スキャフォールド（プロンプト・ルーブリック・反証役）の進化。評価器の更新は人間承認を経る",
      "competitor_coverage": "Sakana は RSI Lab で先行",
      "ip_priority": "later"
    },
    {
      "id": "L9",
      "name": "取り込み・防御層",
      "desc": "文書理解（レイアウト/表/座標）、未信頼コンテンツの隔離と taint 伝播、案件データの分離",
      "competitor_coverage": "抽出は既存勢が強い / 防御は各社とも未成熟",
      "ip_priority": "must"
    },
    {
      "id": "L10",
      "name": "意思決定インターフェース層",
      "desc": "Decision Compiler の最小形（人間3行→命題→数値）、感度分析、EVPI、Action Router のチャネル選択（retrievability駆動）",
      "competitor_coverage": "未確認（外部評価は非公開実装を評価不能と明記）",
      "ip_priority": "must（段階導入）"
