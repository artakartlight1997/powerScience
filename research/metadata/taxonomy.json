  "design_principles": [
    {
      "id": "P1",
      "principle": "タスクが独立並列に分解できるときだけマルチエージェントにする",
      "source": "S-028"
    },
    {
      "id": "P2",
      "principle": "停止条件と検証をアーキテクチャの一級市民にする",
      "source": "S-029"
    },
    {
      "id": "P3",
      "principle": "視点の多様性は自動発見に任せず、実務由来の型で与える",
      "source": "S-031,S-061"
    },
    {
      "id": "P4",
      "principle": "自律だけを売らず、介入点を設計して売る",
      "source": "S-032,S-034"
    },
    {
      "id": "P5",
      "principle": "検証器には生成器が持たない権限（原文取得・再計算・時系列）を与える",
      "source": "S-036"
    },
    {
      "id": "P6",
      "principle": "探索の報酬は decision-relevant な期待情報利得に置く",
      "source": "S-040,S-062"
    },
    {
      "id": "P7",
      "principle": "討論で合意させない。討論は反証の生産にのみ使う",
      "source": "S-046"
    },
    {
      "id": "P8",
      "principle": "長時間実行では『何を忘れるか』を設計し、圧縮時に出典IDを失わない",
      "source": "S-050,S-051"
    },
    {
      "id": "P9",
      "principle": "記憶は量ではなく『意思決定に効いた事実＋反証結果』だけを残す",
      "source": "S-052,S-053"
    },
    {
      "id": "P10",
      "principle": "LLM judge には『良い/悪い』を聞かず、原文支持の二値判定だけを聞く",
      "source": "S-058,S-059"
    },
    {
      "id": "P11",
      "principle": "ACH 行列を一次データ構造にする（レポートは view にすぎない）",
      "source": "S-061,S-062"
    },
    {
      "id": "P12",
      "principle": "監査証跡は後付けせず、探索木そのものを追記専用の一次記録にする",
      "source": "S-079,S-080"
    },
    {
      "id": "P13",
      "principle": "自己改善はスキャフォールド（プロンプト・ワークフロー・反証ルーブリック）に限定し、評価器の定義は人間の承認を経る",
      "source": "S-092,S-094,S-098,S-106"
    },
    {
      "id": "P14",
      "principle": "評価は階層化する（安価な判定で足切り→高価な検証は上位のみ）。judge と真の指標の相関を常時監視する",
      "source": "S-093"
    },
    {
      "id": "P15",
      "principle": "探索の長さに上限を置き、プロキシと現実の乖離を停止条件にする",
      "source": "S-057,S-103"
    },
    {
      "id": "P16",
      "principle": "差別化要素は ∂V/∂M（モデル能力に対する価値の微分）で選別する。∂V/∂M>0 の補完財のみに賭ける",
      "source": "S-108,S-109,S-112,S-113,S-120"
    },
    {
      "id": "P17",
      "principle": "人間の介入は『AIの出力を見る前に人間が先に判断する』『意図的に減速させる』形式に限定する。承認型の介入は過信を招く",
      "source": "S-114"
    },
    {
      "id": "P18",
      "principle": "未信頼コンテンツは隔離し、ツール呼び出しは capability で門番する。Webを読んだLLMに機密アクセス権とツール権限を同時に与えない",
      "source": "S-126,S-127"
    },
    {
      "id": "P19",
      "principle": "数値は必ずコードで計算する。モデルに計算させない。抽出は value|NOT_FOUND|AMBIGUOUS の三値を返す",
      "source": "S-130,S-131,S-090"
    },
    {
      "id": "P20",
      "principle": "矛盾する証拠は平均も抑制もせず、保存して提示し、追加取得タスクに変換する",
      "source": "S-125"
    },
    {
      "id": "P21",
      "principle": "到達可能性(retrievability)を探索の一級変数にする。Web で見つからないと判定した瞬間に channel を VDR/専門家/計算へ切り替える。不在を真に変換しない（三値: supported_negative/unknown/not_searched）",
      "source": "external-assessment-v2,ARGUS,CROWN-QA"
    },
    {
      "id": "P22",
      "principle": "証拠の独立性はクラスタで正規化する。同一上流ソース由来の複数記事を独立支持証拠として数えない",
      "source": "external-assessment-v2,CAMA"
    },
    {
      "id": "P23",
      "principle": "意思決定モデルの取得は最小形から段階導入する（人間3行→命題化→数値モデル）。機械可読な決定コンパイラを前提条件にしない",
      "source": "disc-devils-advocate(F4'),disc-evaluation(DQ6)"
    },
    {
      "id": "P24",
      "principle": "較正のMoat主張は時間軸を分ける。近期は台帳自体、Worker/Source較正は数年がかりの長期資産と位置づける",
      "source": "disc-evaluation"
    }
  ],
