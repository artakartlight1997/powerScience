# OpenRouter(https://openrouter.ai/keys で発行)
OPENROUTER_API_KEY=sk-or-...

# ロール別モデル。生成と検証は必ず別ベンダにする(C-6。同一ベンダは起動拒否)
PRISM_GENERATOR_MODEL=anthropic/claude-sonnet-4.5
PRISM_VERIFIER_MODEL=openai/gpt-4o
PRISM_ONLINE_MODEL=perplexity/sonar

# 同一ベンダを明示的に許す場合のみ 1(推奨しない)
# PRISM_ALLOW_SAME_VENDOR=1

# パス(Docker では docker-compose.yml の volume が既定)
# PRISM_DATA_DIR=./data
# PRISM_INBOX_DIR=./inbox
# PRISM_OUT_DIR=./out
# PRISM_TEMPLATES_DIR=./templates
